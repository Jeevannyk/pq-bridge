# Free keys: https://opt.qpiai.tech  and  https://qcloud.qpiai.tech
QPIAI_OPT_API_KEY=
QCLOUD_API_KEY=
# QpiAI-QSV-Local = in-process QpiAI simulator (no key needed). Set a cloud device name to run on QCloud.
QCLOUD_DEVICE=QpiAI-QSV-Local
# Showcase circuits (QRNG, QAOA) run once here (6 qubits max). QpiAI-QSV-Local needs no subscription; cloud devices
# (QpiAI-QSV-Lite, ...) need an active QCloud subscription. List devices: python -m pqbridge.circuits --devices
QCLOUD_CIRCUIT_DEVICE=QpiAI-QSV-Local
# QCloud rejects jobs for an experiment that does not exist; create one in the QCloud dashboard or keep the default.
QCLOUD_EXPERIMENT=Default Experiment
# Risk-model assumptions (years)
PQB_CRQC_YEARS=8
PQB_MIGRATION_YEARS=3

# --- Email notifications (Mailgun) -------------------------------------------------------------------
# The Scan page "Email report" button sends a PDF of the latest scan to each bank's admin. Fill these in, then restart the console.
# Mailgun: https://app.mailgun.com  ->  Sending -> Domains (domain) and Settings -> API keys (private key).
# A Mailgun SANDBOX domain only delivers to addresses you list under "Authorized Recipients" in the Mailgun dashboard.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Optional. Default: PQ-Bridge Security <security@MAILGUN_DOMAIN>
MAILGUN_FROM=
# US accounts: https://api.mailgun.net (default). EU accounts: https://api.eu.mailgun.net
MAILGUN_API_BASE=https://api.mailgun.net

# Banks that PQ-Bridge reports on (comma separated ids). Each id needs its own BANK_<ID>_* lines below (id upper-cased).
PQB_BANKS=pqbank
BANK_PQBANK_NAME=PQBank
BANK_PQBANK_ADMIN_NAME=
# One or more admin addresses, comma separated
BANK_PQBANK_ADMIN_EMAILS=
# To add another bank: PQB_BANKS=pqbank,otherbank and add BANK_OTHERBANK_NAME / _ADMIN_NAME / _ADMIN_EMAILS
