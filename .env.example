# Free keys: https://opt.qpiai.tech  and  https://qcloud.qpiai.tech
QPIAI_OPT_API_KEY=
QCLOUD_API_KEY=
# QpiAI-QSV-Local = in-process QpiAI simulator (no key needed). Set a cloud device name to run on QCloud.
QCLOUD_DEVICE=QpiAI-QSV-Local
# Risk-model assumptions (years)
PQB_CRQC_YEARS=8
PQB_MIGRATION_YEARS=3
