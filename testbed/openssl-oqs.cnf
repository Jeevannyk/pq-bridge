# Load OpenSSL's default provider plus oqs-provider for every process in the container.
# Clients offer hybrid X25519+HQC first; nginx servers override with their own ssl_ecdh_curve.
openssl_conf = openssl_init

[openssl_init]
providers = provider_sect
ssl_conf = ssl_sect

[provider_sect]
default = default_sect
oqsprovider = oqsprovider_sect

[default_sect]
activate = 1

[oqsprovider_sect]
activate = 1

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
Groups = x25519_hqc1:X25519:prime256v1:hqc1
